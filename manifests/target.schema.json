{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eda-fabric.local/schema/target.schema.json",
  "title": "EDA_Fabric target manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "kind", "sources"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "kind": { "enum": ["hdl-simulation", "hdl-synthesis", "firmware-build"] },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^(hdl|firmware|interfaces|constraints)/" }
    },
    "top_module": { "type": "string" },
    "testbench": { "type": "string" },
    "adapter": { "type": "string" },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exit_code": { "type": "integer", "minimum": 0 },
        "trace_format": { "enum": ["fst", "vcd"] }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "hdl-simulation" } } },
      "then": { "required": ["top_module", "testbench", "adapter"] }
    }
  ]
}
